# Example env for apps/api — copy to .env.development.local and fill in.
#
#   cp apps/api/.env.example apps/api/.env.development.local
#
# Every variable here is validated at boot by src/common/config/env.validation.ts.
# A missing or malformed one crashes startup naming the offender, instead of
# failing later in a way that looks like an application bug.
#
# For the production stack see .env.prod.example at the repo root — there the
# secrets come from mounted files, not from a file like this one.

NODE_ENV=development
PORT=8000

# --- Database (must match docker-compose.yml) ---
DATABASE_USER=aas
DATABASE_PASSWORD=changeme
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=aas

# TLS to Postgres. Pointless over localhost or a private Docker network;
# necessary for managed Postgres or any hop across a network you don't own.
DATABASE_SSL=false
# Only for a provider presenting a private CA. `false` accepts ANY certificate —
# it stops eavesdropping but not impersonation, so choose it deliberately.
# DATABASE_SSL_REJECT_UNAUTHORIZED=true

# Pool size per process. Keep (replicas x this) + the migration job + your psql
# sessions under Postgres's max_connections (100 by default).
DATABASE_POOL_MAX=10

# TypeORM reshaping the schema from the entity files. Development only: against a
# real database it can drop columns with no migration to review or revert, and
# env validation refuses `true` when NODE_ENV=production.
# DATABASE_SYNCHRONIZE=true

# --- Object store (MinIO; `npm run docker:up` starts it) ---
# Where MoMo QR images uploaded through /payment-methods are stored. All five
# are REQUIRED: with one missing the S3 client still builds and the upload still
# returns a URL, just one assembled from the string "undefined".
#
# ENDPOINT is where the API talks to MinIO — localhost when you run the app on
# the host, http://minio:9000 only from inside the docker network.
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=aas-uploads
# PUBLIC base URL a browser loads the image from, with no trailing slash. Create
# the bucket and make it anonymously readable once via the MinIO console at
# http://localhost:9001 — see docs/r2-momo-qr-upload-guide.md.
MINIO_PUBLIC_URL=http://localhost:9000/aas-uploads

# --- Auth / JWT ---
# Must be >=32 chars — generate with: openssl rand -hex 32
# Replacing it invalidates every token in circulation, logging everyone out.
JWT_SECRET=replace_me_with_openssl_rand_hex_32_output_at_least_32_chars
# SECONDS, not a duration string. "15m" would parseInt to 15 (fifteen seconds),
# and anything over a year is rejected as a probable milliseconds mix-up.
JWT_EXPIRES_IN=900
# Read as JWT_REFRESH_EXPIRES_IN; setting the older REFRESH_EXPIRES_IN name
# instead now fails validation rather than being silently ignored.
# This is also the session's ABSOLUTE lifetime — refresh rotation carries the
# original expiry forward rather than extending it, so it is how often a user has
# to log in again regardless of activity.
JWT_REFRESH_EXPIRES_IN=604800

# Password assigned to accounts created through OAuth, which never type one.
BASE_PASSWORD=replace_me

# Required in production: the CORS origin allowlist (comma-separated).
# Unset means no cross-origin browser traffic is allowed at all.
FRONTEND_URL=http://localhost:3000

# --- Cookies (refresh token, OAuth state) ---
# Cross-origin dev (web:3000 <-> api:8000) needs sameSite=none + secure=true.
# Behind a single domain via the reverse proxy, lax is correct.
COOKIE_SAME_SITE=lax
COOKIE_SECURE=false

# --- Dev auth bypass ---
# Enables POST /auth/dev/login {email}: find-or-creates a verified account and
# returns a real token + refresh cookie, no OAuth provider or verification mail
# involved. This is how you "log in with GitHub" locally without a GitHub app.
# Refused at boot when NODE_ENV=production.
DEV_AUTH_BYPASS=true

# --- OAuth ---
# Optional per provider, but half-configured is rejected at boot: set all three
# of a provider's variables or none of them. The `your_*` placeholders count as
# unset, so a freshly copied file doesn't look configured.
#
# Leave all of this unset in development and use DEV_AUTH_BYPASS above — the
# OAuth apps are registered against the PRODUCTION domain only, e.g.
#   GITHUB_CALLBACK_URL=https://api.<prod-domain>/auth/github/callback
# and the same value must be entered in the provider's console (GitHub OAuth
# App "Authorization callback URL", Google "Authorized redirect URIs",
# Facebook "Valid OAuth Redirect URIs"). An unconfigured provider's routes
# answer 503 instead of starting a broken flow.

# GOOGLE_CLIENT_ID=your_google_client_id_here
# GOOGLE_CLIENT_SECRET=your_google_client_secret_here
# GOOGLE_CALLBACK_URL=https://api.your-domain.com/auth/google/callback

# GITHUB_CLIENT_ID=your_github_client_id_here
# GITHUB_CLIENT_SECRET=your_github_client_secret_here
# GITHUB_CALLBACK_URL=https://api.your-domain.com/auth/github/callback

# FACEBOOK_CLIENT_ID=your_facebook_client_id_here
# FACEBOOK_CLIENT_SECRET=your_facebook_client_secret_here
# FACEBOOK_CALLBACK_URL=https://api.your-domain.com/auth/facebook/callback

# --- Email (Mailpit locally: SMTP on 1025, UI on 8025) ---
EMAIL_HOST=localhost
EMAIL_PORT=1025
EMAIL_SECURE=false
EMAIL_USER=
EMAIL_PASS=
