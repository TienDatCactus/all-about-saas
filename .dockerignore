# Keep the Docker build context small and secret-free.
# Everything here is excluded from `COPY . .` in any Dockerfile.

**/node_modules
**/dist
**/build
**/.turbo
**/.next
**/coverage
**/.git
**/.github
**/.husky

# Never ship real secrets into an image; examples are fine.
**/.env
**/.env.*
!**/.env.example

# Compose mounts these at runtime. Baking them into a layer would defeat the
# entire point of using files instead of env vars.
secrets/

# Database dumps — gigabytes of build-context bloat with no business in an image.
backups/

**/.vscode
**/.idea
**/*.log
**/.DS_Store

Dockerfile*
**/Dockerfile*
docker-compose*.yml
