# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# Dependencies
node_modules
.pnp
.pnp.js

# Local env files. Deny-all then re-allow the examples, so a new filename
# (.env.prod, .env.staging, …) is ignored by default instead of only when
# somebody remembers to add it here.
.env
.env.*
!.env.example
!.env.*.example

# Testing
coverage

# Turbo
.turbo

# Vercel
.vercel

# Build Outputs
.next/
out/
build
dist


# Debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Docker Compose secrets (see the header of docker-compose.prod.yml).
# Whitelisted README so the directory's purpose stays in the repo.
/secrets/*
!/secrets/README.md

# Database dumps written by the backup sidecar.
/backups/

# Misc
.DS_Store
*.pem
