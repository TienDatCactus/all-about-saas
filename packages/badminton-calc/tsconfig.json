{
  "extends": "@repo/typescript-config/base.json",
  "compilerOptions": {
    // Base sets module/moduleResolution to NodeNext; combined with the
    // package's "type": "commonjs" that emits CommonJS for the API to require.
    "outDir": "dist",
    "rootDir": "src",
    "lib": ["es2022"],
    "types": [],
    // The algorithm indexes parallel arrays it just built (fair/base/order all
    // have participants.length entries), so the checked-index flag would only
    // buy non-null assertions on every access.
    "noUncheckedIndexedAccess": false
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}
