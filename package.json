{
  "name": "@aas",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "email:dev": "cd packages/transactional && npm run email",
    "email:build": "cd packages/transactional && npm run build",
    "docker:up": "docker compose --env-file apps/api/.env.development.local up -d",
    "docker:down": "docker compose down",
    "docker:reset": "docker compose down -v",
    "docker:logs": "docker compose logs -f",
    "bootstrap": "npm install && npm run docker:up",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@types/node": "^25.9.3",
    "husky": "^9.1.7",
    "prettier": "^3.7.4",
    "turbo": "^2.9.18",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "npm@11.13.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "dependencies": {
    "@nestjs/mapped-types": "*",
    "ua-parser-js": "^2.0.10",
    "use-image": "^1.1.4"
  }
}
