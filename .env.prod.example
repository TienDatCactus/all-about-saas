# Example env for the production stack — copy to .env.prod on the host.
#
#   docker compose -f docker-compose.prod.yml --env-file .env.prod up -d --build
#
# This file holds only NON-secret values. It exists for Compose *interpolation*
# (the `${VAR}` substitutions in docker-compose.prod.yml), which is a separate
# mechanism from the `environment:` block that sets variables inside a container.
#
# The two actual secrets are NOT here. They are files under ./secrets, mounted at
# /run/secrets and read via DATABASE_PASSWORD_FILE / JWT_SECRET_FILE — see
# secrets/README.md. Putting them here would undo that.

# --- Domains (Caddy requests certificates for these, so DNS must already
#     point at this host or ACME validation fails) ---
DOMAIN=example.com
API_DOMAIN=api.example.com

# Where Let's Encrypt sends certificate-expiry warnings.
ACME_EMAIL=ops@example.com

# --- Database (the password is a mounted secret, not a variable) ---
DATABASE_USER=aas
DATABASE_NAME=aas

# --- Backups (the `backup` sidecar; see scripts/backup-db.sh for the offsite leg) ---
# Local dumps land in ./backups. These are LOCAL-ONLY until you configure
# BACKUP_REMOTE for the script's rclone upload — a dump on the same disk as the
# database does not survive the failure it exists for.
BACKUP_KEEP_DAYS=14
BACKUP_INTERVAL_SECONDS=86400

# Postgres is on the internal network only, so TLS between api and postgres adds
# nothing. Turn it on if the database ever moves off this host.
DATABASE_SSL=false
DATABASE_POOL_MAX=10

# --- API ---
# CORS allowlist, comma-separated. Must match how users actually reach the web app.
FRONTEND_URL=https://example.com
JWT_EXPIRES_IN=900
JWT_REFRESH_EXPIRES_IN=604800

# --- OAuth ---
# Client IDs and callback URLs are not secrets; the secrets are files under
# ./secrets (google_client_secret, github_client_secret, facebook_client_secret
# — see secrets/README.md). A provider is enabled by setting BOTH lines below;
# compose then points its *_CLIENT_SECRET_FILE at the mounted file. Providers
# you skip: leave the lines unset and `touch` an empty placeholder file so the
# mount exists.
#
# The callback URL is the PUBLIC one and must byte-match the value entered in
# the provider's console (GitHub "Authorization callback URL", Google
# "Authorized redirect URIs", Facebook "Valid OAuth Redirect URIs"). Under the
# single-domain nginx variant the API lives at /api on the web domain:
# GOOGLE_CLIENT_ID=1234-abc.apps.googleusercontent.com
# GOOGLE_CALLBACK_URL=https://example.com/api/auth/google/callback
# GITHUB_CLIENT_ID=Iv1_abcdef
# GITHUB_CALLBACK_URL=https://example.com/api/auth/github/callback
# FACEBOOK_CLIENT_ID=123456789
# FACEBOOK_CALLBACK_URL=https://example.com/api/auth/facebook/callback

# Password assigned to accounts created through OAuth (they never type one).
# Recommended once OAuth is on — without it those accounts fall back to the
# provider's user id as their password. Generate like jwt_secret:
#   openssl rand -base64 24 | tr -d '\r\n' > secrets/base_password
# BASE_PASSWORD_FILE=/run/secrets/base_password

# --- Object store (MinIO — the MoMo QR images hosts upload) ---
# The api will NOT boot without a complete object-store config; env validation
# refuses it rather than letting uploads return URLs pointing at nothing.
#
# Only the root user is set here. Its password is a mounted secret, like the
# database password:
#   openssl rand -base64 24 | tr -d '\r\n' > secrets/minio_root_password
# Compose then wires it to the api as MINIO_SECRET_KEY_FILE and to minio itself
# as MINIO_ROOT_PASSWORD_FILE — the same file, never an env var.
MINIO_ROOT_USER=aas-minio
# Loopback port the S3 API is published on, for the nginx deployment to proxy
# /storage/ at. Change it only if 9000 is already taken on the host.
# MINIO_HOST_PORT=9000
#
# Public base URL the QR <img> on a share page loads from. Compose defaults it
# to https://${API_DOMAIN}/storage/aas-uploads, which is right for the
# two-domain layout (Caddyfile, deploy/nginx/twinfoundry.org.conf). Uncomment
# and set it for the SINGLE-DOMAIN nginx variant, which has no API_DOMAIN:
# MINIO_PUBLIC_URL=https://example.com/storage/aas-uploads

# --- Web ---
# Baked into the bundle at BUILD time (Vite inlines import.meta.env), so changing
# it needs a rebuild, not just a restart.
#
# Single-domain variant (deploy/nginx/*-single-domain.conf): the API is a path
# on the web domain. Two-domain variant: https://api.example.com instead.
VITE_API_BASE_URL=https://example.com/api
