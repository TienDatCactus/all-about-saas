{
	"version": "0.0.1",
	"configurations": [
		{
			"name": "web",
			"runtimeExecutable": "npm",
			"runtimeArgs": ["run", "dev", "--workspace", "@app/web"],
			"port": 3000
		},
		{
			"name": "email-preview",
			"runtimeExecutable": "npm",
			"runtimeArgs": ["run", "email", "--workspace", "@transactional/emails"],
			"port": 4000
		},
		{
			"name": "api",
			"runtimeExecutable": "npm",
			"runtimeArgs": ["run", "dev", "--workspace", "@app/api"],
			"port": 8000
		}
	]
}
